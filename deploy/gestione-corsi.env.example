# Variabili d'ambiente di produzione per gestione-corsi (lette da ecosystem.config.js e start.sh).
#
# Sul server:
#   cp gestione-corsi.env.example gestione-corsi.env
#   chmod 600 gestione-corsi.env
# poi compilare i valori. gestione-corsi.env contiene la password del database: non va mai in git.

# --- Database MySQL (obbligatorio: DB_PASSWORD) ---
DB_URL=jdbc:mysql://localhost:3306/gestione_corsi?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Rome
DB_USERNAME=gestione_corsi_user
DB_PASSWORD=

# --- Server web ---
# Porta HTTP dell'applicazione (default 8080)
PORT=8080

# --- Indirizzo pubblico e recupero password ---
# Indirizzo con cui gli utenti aprono l'applicazione, usato nei link delle email (obbligatorio in produzione)
APP_URL=https://corsi.example.org
# Ore di validità del link di recupero password (default 36)
PASSWORD_RESET_VALIDITA_ORE=36

# --- Associazione (testata di ricevute e conferme di iscrizione) ---
ASSOCIAZIONE_NOME=MOSSON Drum & Bugle Corps
ASSOCIAZIONE_INDIRIZZO=
ASSOCIAZIONE_CODICE_FISCALE=
ASSOCIAZIONE_EMAIL=
# IBAN per il bonifico, riportato nelle conferme di iscrizione
ASSOCIAZIONE_IBAN=

# --- Email (SMTP) ---
# Senza MAIL_HOST l'invio è simulato: registrato in "Email inviate" con esito "simulato" e scritto nel log.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Mittente, es. "MOSSON <segreteria@example.org>"
MAIL_FROM=
MAIL_STARTTLS=true

# --- Avvio (usate solo dagli script, non passate all'applicazione) ---
# Nome del JAR in questa cartella (default gestione-corsi.jar)
APP_JAR=gestione-corsi.jar
# Eseguibile Java 21 (default "java" dal PATH), es. /home/cloud/.sdkman/candidates/java/current/bin/java
#JAVA_BIN=java
# Opzioni della JVM (default: le stesse qui sotto)
JAVA_OPTS=-Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Europe/Rome
